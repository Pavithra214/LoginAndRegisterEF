    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - FlipLoginAndRegister</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/FlipLoginAndRegister.styles.css" asp-append-version="true" />
        <link href="bootstrap-5.3.3-dist/css/bootstrap-grid.css" rel="stylesheet" />
        <link href="bootstrap-5.3.3-dist/css/bootstrap-grid.min.css" rel="stylesheet" />
        <link href="bootstrap-5.3.3-dist/css/bootstrap-grid.rtl.css" rel="stylesheet" />
        <link href="bootstrap-5.3.3-dist/css/bootstrap-grid.rtl.min.css" rel="stylesheet" />
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.8.3/font/bootstrap-icons.min.css" rel="stylesheet">
        <script src="bootstrap-5.3.3-dist/js/bootstrap.bundle.js"></script>
        <script src="bootstrap-5.3.3-dist/js/bootstrap.bundle.min.js"></script>
        <script src="bootstrap-5.3.3-dist/js/bootstrap.esm.js"></script>
        <script src="bootstrap-5.3.3-dist/js/bootstrap.esm.min.js"></script>
        <script src="bootstrap-5.3.3-dist/js/bootstrap.js"></script>
        <script src="bootstrap-5.3.3-dist/js/bootstrap.min.js"></script>
        <style>
            .navbar-custom {
                background-color: #26a541;
                width:1500px

            }

                .navbar-custom .navbar-nav .nav-link {
                    color: white;
                }

                .navbar-custom .navbar-brand {
                    color: white;
                }
            .card-body {
                height: 200px; /* Set a fixed height for card body */
            }
        </style>
    </head>
    <body>
  
            <nav class="navbar navbar-expand-lg navbar-text  navbar-custom">
                <div class="container-fluid">
                    <a class="navbar-brand" href="javascript:void(0)"><strong>FlipShop</strong></a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mynavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <button type="button" class="btn btn-primary">
                        <i class="bi bi-cart"></i>
                        <strong>Cart</strong> <span class="badge bg-danger">3</span>

                    </button>

                    <div class="collapse navbar-collapse justify-content-center" id="mynavbar">
                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">
                                <a class="nav-link" href="javascript:void(0)"><strong>Return and orders</strong></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="javascript:void(0)"><strong>Become a seller</strong></a>
                            </li>
                        <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Login"><strong>Login</strong></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Register"><strong>Register</strong></a>
                        </li>
                        </ul>
                        <form class="d-flex">
                            <input class="form-control me-2" type="text" placeholder="Search">
                            <button class="btn btn-primary" type="button"><strong>Search</strong></button>
                        </form>
                    </div>
                </div>
            </nav>

        <div class="container mt-4">
            @RenderBody()
        </div>

        <footer class="bg-dark text-white text-center py-3 mt-4">
            &copy; 2025 FlipShop Shop - All Rights Reserved
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
    </html>
